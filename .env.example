VITE_API_BASE_URL=http://localhost:8080/api/v1

# Home dashboard endpoints that lexly-backend doesn't have yet (docs/HOME_DASHBOARD_API_CONTRACT.md).
# Leave false until the endpoint is deployed; the UI shows a "not tracked yet" state meanwhile.
VITE_API_USERS_ME=false
VITE_API_UNIFIED_SEARCH=false
VITE_API_PRACTICE_STATS=false
VITE_API_LEARNING_PROGRESS=false

# Dev server only: populated | empty | error | loading — renders labelled sample data on Home.
# Ignored by production builds. Leave unset for normal development.
# VITE_HOME_MOCKS=populated
